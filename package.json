{
  "name": "markdown-lint",
  "displayName": "Markdown Preview Lite",
  "description": "Lightweight Markdown preview with multiple themes, table of contents, math formulas, code highlighting, and HTML export.",
  "version": "0.5.0",
  "publisher": "hyshine",
  "license": "MIT",
  "author": "jessy",
  "repository": {
    "type": "git",
    "url": "https://github.com/hy-shine/vscode-markdown-lint.git"
  },
  "bugs": {
    "url": "https://github.com/hy-shine/vscode-markdown-lint/issues"
  },
  "homepage": "https://github.com/hy-shine/vscode-markdown-lint#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "toc",
    "mermaid",
    "formatter"
  ],
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdown-lint.openPreview",
        "title": "Preview with Markdown Preview Lite",
        "icon": {
          "light": "images/open-preview.svg",
          "dark": "images/open-preview-dark.svg"
        }
      },
      {
        "command": "markdown-lint.openPreviewInline",
        "title": "Markdown Preview Lite: Open Preview Inline"
      },
      {
        "command": "markdown-lint.openPreviewToSide",
        "title": "Markdown Preview Lite: Open Preview to the Side"
      },
      {
        "command": "markdown-lint.formatDocument",
        "title": "Markdown Preview Lite: Format Document"
      },
      {
        "command": "markdown-lint.refreshToc",
        "title": "Markdown Preview Lite: Refresh TOC"
      },
      {
        "command": "markdown-lint.exportHtml",
        "title": "Markdown Preview Lite: Export HTML"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdown-lint.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Preview Lite",
      "properties": {
        "markdown-lint.themeMode": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "Theme mode for the Markdown Preview Lite preview."
        },
        "markdown-lint.previewMode": {
          "type": "string",
          "enum": [
            "beside",
            "inline"
          ],
          "enumDescriptions": [
            "Open the preview beside the Markdown editor.",
            "Open the preview in the current editor group."
          ],
          "default": "beside",
          "description": "Default Markdown preview placement. Use 'beside' for split preview or 'inline' for preview in the current editor group."
        },
        "markdown-lint.previewStyle": {
          "type": "string",
          "enum": [
            "default",
            "github",
            "notion",
            "tokyo-night",
            "obsidian",
            "paper",
            "typora"
          ],
          "enumDescriptions": [
            "Default clean style",
            "GitHub-flavored markdown style",
            "Notion-like minimal style",
            "Tokyo Night dark theme style",
            "Obsidian-inspired style",
            "Paper-like document style",
            "Typora-inspired style (Whitey light / Night dark)"
          ],
          "default": "default",
          "description": "Preview style preset for Markdown Preview Lite. Options: default, github, notion, tokyo-night, obsidian, paper, typora."
        },
        "markdown-lint.showToc": {
          "type": "boolean",
          "default": true,
          "description": "Show the table of contents sidebar in the preview."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --outfile=dist/extension.js --external:vscode --external:prettier --format=cjs --sourcemap",
    "watch": "npm run compile -- --watch",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "marked": "^15.0.12",
    "mermaid": "^11.15.0",
    "prettier": "^3.8.3"
  }
}
